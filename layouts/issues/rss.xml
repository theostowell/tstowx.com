   {{- $pctx := . }}
   {{- if .IsHome }}{{ $pctx = site }}{{ end }}
   {{- $pages := $pctx.RegularPages }}
   {{- $limit := site.Config.Services.RSS.Limit }}
   {{- if ge $limit 1 }}
   {{- $pages = $pages | first $limit }}
   {{- end }}
   {{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
   <feed xmlns="http://www.w3.org/2005/Atom">
     <title>Newsletter issues | {{ site.Title }}</title>
     <link href="{{ .Permalink }}" />
     <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
     <id>{{ .Permalink }}</id>
     <author>
       <name>{{ with site.Params.author.name }}{{ . }}{{ else }}{{ site.Author.name }}{{ end }}</name>
     </author>
     {{- range $pages }}
     <entry>
       <title>{{ .Title }}</title>
       <link href="{{ .Permalink }}" />
       <id>{{ .Permalink }}</id>
       <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
       <summary>{{ .Summary | plainify }}</summary>
       <content type="html">{{ .Content | safeHTML | replaceRE "<img([^>]*)>" "<img$1 />" }}</content>
     </entry>
     {{- end }}
   </feed>