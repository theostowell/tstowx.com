{{- /*
  Netlify _redirects, generated from the same rule the templates use.

  Anything with an off-site home gets a forced 301 to it, so /bro-text/,
  /wild/ and the rest keep working for old links and search results without
  ever rendering a page here. The trailing `!` overrides the fallback page
  Hugo still writes at that path (used by a local preview).
*/ -}}
{{- $lines := slice "# Generated by Hugo from each note's front matter. Do not edit." -}}
{{- $seen := slice -}}
{{- range site.RegularPages -}}
  {{- $o := partial "outbound.html" . -}}
  {{- if $o.external -}}
    {{- $paths := slice .RelPermalink (strings.TrimSuffix "/" .RelPermalink) -}}
    {{- range .Aliases -}}
      {{- $a := printf "/%s" (strings.Trim . "/") -}}
      {{- $paths = $paths | append $a -}}
      {{- $paths = $paths | append (printf "%s/" $a) -}}
    {{- end -}}
    {{- range $paths -}}
      {{- if not (in $seen .) -}}
        {{- $seen = $seen | append . -}}
        {{- $lines = $lines | append (printf "%s  %s  301!" . $o.url) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{ delimit $lines "\n" }}
